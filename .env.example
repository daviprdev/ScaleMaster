# === Worker RPA Standalone ===
# Este worker NÃO se conecta ao Supabase do SaaS.
# A conexão conta↔SaaS acontece apenas via Magic Link OAuth na última etapa.

# Chave de criptografia AES-256-GCM (mesma do SaaS para decifrar credenciais)
ENCRYPTION_SECRET=sua-chave-secreta-aqui

# Diretório de perfis persistentes do navegador
ONBOARDING_PROFILES_DIR=/opt/rpa/profiles

# Concorrência máxima de sessões Playwright simultâneas
MAX_CONCURRENT_JOBS=3

# Intervalo entre ciclos de polling (segundos)
POLL_INTERVAL_SECONDS=30

# URL base do SaaS para Magic Links
SAAS_BASE_URL=https://autoscale-ia.vercel.app

# Secret para health check e API de jobs
WORKER_API_SECRET=mude-este-valor

# Porta do health check / API
HEALTH_PORT=8080

# Modo headless do Chromium (0 = com janela para debug via VNC/xvfb)
BROWSER_HEADLESS=1