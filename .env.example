# ─────────────────────────────────────────────────────────────
# AutoScale — variáveis de ambiente (deploy em VPS via Docker)
#
# Copie para .env e preencha. NUNCA commite o .env preenchido.
#   cp .env.example .env
#
# Observações importantes:
# - As variáveis NEXT_PUBLIC_* são inlinadas no bundle do cliente em TEMPO DE
#   BUILD. Precisam estar preenchidas ANTES de `docker compose build`.
# - As demais são lidas em runtime pelo servidor.
# ─────────────────────────────────────────────────────────────

# ── Deploy / Reverse proxy (Caddy) ──────────────────────────
# Domínio público apontando (DNS A/AAAA) para o IP da VPS. Caddy emite o TLS.
DOMAIN=
ACME_EMAIL=
# URL interna do serviço web na rede do compose (raramente precisa mudar).
WEB_INTERNAL_URL=http://web:3000

# ── Supabase (Banco + Auth + Storage) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── URLs públicas da aplicação ──────────────────────────────
# Use https://SEU_DOMINIO (o mesmo de DOMAIN).
NEXT_PUBLIC_APP_URL=
# Base dos links gerenciáveis (/r/<slug>). Normalmente = NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_REDIRECT_BASE_URL=

# ── Meta / Instagram — App global (BYOC usa credenciais no banco) ──
# App padrão usado quando a conta não tem um App próprio configurado (BYOC).
NEXT_PUBLIC_META_CLIENT_ID=
META_CLIENT_SECRET=
# Instagram Login API (usado nas rotas de debug/admin e link mágico).
NEXT_PUBLIC_INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Nota: credenciais BYOC por usuário (App ID + App Secret) ficam na tabela
# user_meta_apps do Supabase (criptografadas), não em variável de ambiente.

# ── Apify (scraping de Reels) ───────────────────────────────
# Token único:
APIFY_API_TOKEN=
# OU pool de tokens separados por vírgula (tem prioridade sobre o de cima):
APIFY_API_TOKENS=

# ── Criptografia (AES-256-GCM: App Secret BYOC, proxies dedicados) ──
# Qualquer string secreta; é derivada via SHA-256 para a chave AES-256.
ENCRYPTION_SECRET=

# ── Cron (autenticação dos endpoints /api/cron/*) ───────────
# O serviço "cron" envia este valor como `Authorization: Bearer <CRON_SECRET>`.
# A aplicação valida (fail-closed): sem CRON_SECRET, os crons não executam.
CRON_SECRET=

# ── Servidor Python (FastAPI + instagrapi) ──────────────────
# No compose o web fala com o serviço pelo nome interno (default abaixo).
PYTHON_SERVER_URL=http://python-server:8000
PYTHON_SERVER_SECRET=

# ── Web Push (VAPID — notificações push) ────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: ou URL do responsável (exigido pela spec VAPID).
VAPID_SUBJECT=

# ── Webhook ApexVips (registro de vendas) ───────────────────
APEXVIPS_WEBHOOK_SECRET=

# ── Proxy ────────────────────────────────────────────────────
# Não há variável de proxy global: cada conta usa um proxy dedicado gravado
# (criptografado) no Supabase, ou o estoque proxy_pool. Nada a definir aqui.
