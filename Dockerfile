# syntax=docker/dockerfile:1
# Multi-stage Dockerfile for ScaleMaster Next.js app (standalone output)
# Requires: output: 'standalone' in next.config.ts

# ---------------------------------------------------------------------------
# Stage 1: Install dependencies
# ---------------------------------------------------------------------------
FROM node:22-alpine AS deps
WORKDIR /app

# Copy package files first for better layer caching
COPY package.json package-lock.json* pnpm-lock.yaml* ./

# Detect lockfile and install accordingly
# --legacy-peer-deps required due to peer dependency conflicts in lockfile
RUN if [ -f pnpm-lock.yaml ]; then \
      corepack enable && pnpm install --frozen-lockfile; \
    elif [ -f package-lock.json ]; then \
      npm ci --legacy-peer-deps; \
    else \
      npm install --legacy-peer-deps; \
    fi

# ---------------------------------------------------------------------------
# Stage 2: Build the application
# ---------------------------------------------------------------------------
FROM node:22-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# P1: Variáveis públicas incorporadas no build do Next.js.
# Esses valores NÃO são segredos — são URLs/chaves públicas que o cliente precisa.
# Segredos (SUPABASE_SERVICE_ROLE_KEY, ENCRYPTION_SECRET, etc.) ficam apenas no runtime.
# Passe via: docker build --build-arg NEXT_PUBLIC_SUPABASE_URL=... --build-arg NEXT_PUBLIC_APP_URL=...
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_INSTAGRAM_APP_ID
ARG NEXT_PUBLIC_META_CLIENT_ID

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_INSTAGRAM_APP_ID=$NEXT_PUBLIC_INSTAGRAM_APP_ID
ENV NEXT_PUBLIC_META_CLIENT_ID=$NEXT_PUBLIC_META_CLIENT_ID

# Disable telemetry during build
ENV NEXT_TELEMETRY_DISABLED=1

RUN if [ -f pnpm-lock.yaml ]; then \
      corepack enable && pnpm build; \
    else \
      npm run build; \
    fi

# ---------------------------------------------------------------------------
# Stage 3: Production runtime
# ---------------------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# FFmpeg do sistema — o único que o app usa (fluent-ffmpeg o acha no PATH).
# Atualiza junto com a imagem base do Alpine; ver lib/ffmpeg-input.ts.
# font-dejavu: fonte do efeito "Texto na tela" do Loop (drawtext), em
# /usr/share/fonts/dejavu/DejaVuSans-Bold.ttf — ver lib/video-effects.ts.
RUN apk add --no-cache ffmpeg font-dejavu

# Non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy standalone output (generated by Next.js with output: 'standalone')
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]