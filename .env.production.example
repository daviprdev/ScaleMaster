# =============================================================================
# AutoScale-IA — Production Environment Variables Template
# =============================================================================
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to git.
# =============================================================================

# -----------------------------------------------------------------------------
# App URL (REQUIRED for VPS deployment)
# -----------------------------------------------------------------------------
# Canonical public URL of the application. Used for OAuth redirects, magic links,
# and webhook URLs. Must NOT have a trailing slash.
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_REDIRECT_BASE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Supabase (keep existing managed project)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Cron Authentication
# -----------------------------------------------------------------------------
# Same secret used on Vercel. Systemd timers send this as Bearer token.
CRON_SECRET=your-cron-secret

# -----------------------------------------------------------------------------
# Meta / Instagram OAuth
# -----------------------------------------------------------------------------
NEXT_PUBLIC_META_CLIENT_ID=your-meta-app-id
META_CLIENT_SECRET=your-meta-client-secret

# -----------------------------------------------------------------------------
# Apify (cloud scraping — unchanged)
# -----------------------------------------------------------------------------
APIFY_API_TOKEN=your-apify-token
# Optional: comma-separated list for token pool rotation
# APIFY_API_TOKENS=token1,token2,token3

# -----------------------------------------------------------------------------
# Python Server (RPA worker — can run on same VPS)
# -----------------------------------------------------------------------------
PYTHON_SERVER_URL=http://127.0.0.1:8000
PYTHON_SERVER_SECRET=your-python-server-secret

# -----------------------------------------------------------------------------
# Web Push Notifications
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=admin@your-domain.com

# -----------------------------------------------------------------------------
# Sales Webhooks (incoming)
# -----------------------------------------------------------------------------
SHARKBOT_WEBHOOK_SECRET=your-sharkbot-secret
APEXVIPS_WEBHOOK_SECRET=your-apexvips-secret

# -----------------------------------------------------------------------------
# Encryption Keys (PRESERVE EXISTING VALUES — do not regenerate)
# -----------------------------------------------------------------------------
# These keys encrypt data already stored in the database.
# Changing them will make existing encrypted data unreadable.
ENCRYPTION_KEY=your-existing-encryption-key