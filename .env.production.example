# =============================================================================
# ScaleMaster — Production Environment Variables Template
# =============================================================================
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to git.
# =============================================================================

# -----------------------------------------------------------------------------
# App URL (REQUIRED for VPS deployment)
# -----------------------------------------------------------------------------
# Canonical public URL of the application. Used for OAuth redirects, magic links,
# and webhook URLs. Must NOT have a trailing slash.
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_REDIRECT_BASE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Supabase (keep existing managed project)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Chave secreta nova (sb_secret_...), só do servidor. Com ela e "IP Address
# Forwarding" ligado (Authentication > Rate Limits), o login por username e o
# /auth/callback mandam o IP do cliente no Sb-Forwarded-For. Opcional: sem ela,
# essas chamadas usam a anon key e dividem o limite por IP da VPS.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Cron Authentication
# -----------------------------------------------------------------------------
# Systemd timers send this as Bearer token (must match /opt/scalemaster/.env.cron).
CRON_SECRET=your-cron-secret

# -----------------------------------------------------------------------------
# Meta / Instagram OAuth
# -----------------------------------------------------------------------------
NEXT_PUBLIC_META_CLIENT_ID=your-meta-app-id
META_CLIENT_SECRET=your-meta-client-secret

# -----------------------------------------------------------------------------
# Apify (cloud scraping — usado por Clone e prefetch; NÃO usado por Inspirações)
# -----------------------------------------------------------------------------
APIFY_API_TOKEN=your-apify-token
# Optional: comma-separated list for token pool rotation
# APIFY_API_TOKENS=token1,token2,token3

# -----------------------------------------------------------------------------
# ScrapeCreators (Instagram Reels — fonte exclusiva da aba Inspirações)
# -----------------------------------------------------------------------------
# Chave da API ScrapeCreators (https://scrapecreators.com). Usada SOMENTE no
# backend para buscar Reels de perfis públicos. Nunca exposta ao navegador.
SCRAPECREATORS_API_KEY=your-scrapecreators-api-key

# -----------------------------------------------------------------------------
# Web Push Notifications
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=admin@your-domain.com

# -----------------------------------------------------------------------------
# Sales Webhooks (incoming)
# -----------------------------------------------------------------------------
SHARKBOT_WEBHOOK_SECRET=your-sharkbot-secret
APEXVIPS_WEBHOOK_SECRET=your-apexvips-secret

# -----------------------------------------------------------------------------
# Encryption Keys (PRESERVE EXISTING VALUES — do not regenerate)
# -----------------------------------------------------------------------------
# These keys encrypt data already stored in the database.
# Changing them will make existing encrypted data unreadable.
# IMPORTANT: The code reads ENCRYPTION_SECRET, not ENCRYPTION_KEY.
ENCRYPTION_SECRET=your-existing-encryption-secret

# -----------------------------------------------------------------------------
# Python Server / Scraper (optional — required for process-scrape-jobs cron)
# -----------------------------------------------------------------------------
# If you keep the Instagram profile scraper running on the VPS, set these.
# Without PYTHON_SERVER_URL, the scrape-jobs cron is skipped gracefully.
# When running via docker-compose, use the internal service name:
# PYTHON_SERVER_URL=http://python-server:8000
# For local development without compose, use localhost:
# PYTHON_SERVER_URL=http://127.0.0.1:8000
PYTHON_SERVER_URL=http://python-server:8000
PYTHON_SERVER_SECRET=your-python-server-secret

# -----------------------------------------------------------------------------
# Web Push Notifications (VAPID subject email)
# -----------------------------------------------------------------------------
# The push library expects VAPID_SUBJECT (not VAPID_EMAIL).
VAPID_SUBJECT=admin@your-domain.com