{
  "manifest_version": 3,
  "name": "Scale Master Story",
  "short_name": "SM Story",
  "version": "1.0.1",
  "description": "Story com adesivo de link, legenda no adesivo e destaque — Scale Master.",
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "action": {
    "default_title": "Scale Master Story",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png",
      "48": "icones/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*", "https://i.instagram.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["instagram.js", "conteudo.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["painel.html", "icones/48.png"],
      "matches": ["https://www.instagram.com/*"]
    }
  ]
}
